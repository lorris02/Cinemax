@model Cinemax.Models.Genre

@{
    ViewData["Title"] = "Edit genre";
}

<div class="page narrow">
    <a class="back-link" asp-action="Index">&larr; Back to genres</a>
    <h1>Edit genre</h1>
    <form asp-action="Edit" class="form-card">
        <input type="hidden" asp-for="GenreId" />
        <partial name="_GenreFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
