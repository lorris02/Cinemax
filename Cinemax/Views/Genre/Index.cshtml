@model IEnumerable<Cinemax.Models.Genre>

@{
    ViewData["Title"] = "Index";
}

<h1>Movie Genres</h1>
<p>Browse through our movie genres and discover films that match your mood. Each genre offers a unique cinematic experience.</p>


<p>
	@if (User.IsInRole("Administrator")) //i added this to restrict access to only admin,cuz i want only admins to be albe to edit anything concenring genres
    {
        <text>
            <a asp-action="Create">Create New</a>
        </text>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Genre
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenreId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GenreId)
                </td>

	        
            <td>
					@if (User.IsInRole("Administrator"))//i addded this to restrict access to only admin,cuz i want only admins to be albe to edit anythiing concerning the genres
                 {
                 <text>
                <a asp-action="Edit" asp-route-id="@item.GenreId">Edit</a> |
                <form asp-action="Delete" asp-route-id="@item.GenreId" method="post" class="d-inline" onsubmit="return confirm('Delete this genre?');">
                      <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                  </form>
                </text>
                 }
            </td>
        </tr>
}
    </tbody>
</table>
<p>
    Now that you've picked a genre, check out movies that suit your taste<a asp-controller="Movie" asp-action="Index"> here</a>.
</p>
