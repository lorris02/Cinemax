@model IEnumerable<Cinemax.Models.Genre>

@{
    ViewData["Title"] = "Genres";
    var covers = (Dictionary<int, (string? Backdrop, int Count)>)ViewBag.Covers;
    var isAdmin = User.IsInRole("Administrator");
}

<div class="page">
    <div class="section-head page-head">
        <div>
            <h1>Genres</h1>
            <p class="lead-text">Pick a mood and start browsing</p>
        </div>
        @if (isAdmin)
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">Add genre</a>
        }
    </div>

    <div class="genre-grid">
        @foreach (var item in Model)
        {
            var cover = covers.GetValueOrDefault(item.GenreId);
            <div>
                <a class="genre-tile" asp-controller="Movie" asp-action="Index" asp-route-genreId="@item.GenreId" style="--hero-image: url('@cover.Backdrop')">
                    <strong>@item.Name</strong>
                    <small>@cover.Count @(cover.Count == 1 ? "movie" : "movies")</small>
                </a>
                @if (isAdmin)
                {
                    <div class="admin-row">
                        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@item.GenreId">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.GenreId" method="post" onsubmit="return confirm('Delete this genre?');">
                            <button type="submit" class="btn btn-danger-soft btn-sm">Delete</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
