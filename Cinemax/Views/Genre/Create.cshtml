@model Cinemax.Models.Genre

@{
    ViewData["Title"] = "Add genre";
}

<div class="page narrow">
    <a class="back-link" asp-action="Index">&larr; Back to genres</a>
    <h1>Add genre</h1>
    <form asp-action="Create" class="form-card">
        <partial name="_GenreFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add genre</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
