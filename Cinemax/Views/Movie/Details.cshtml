@model Cinemax.Models.Movie

@{
    ViewData["Title"] = Model.MovieTitle;
    var writeUrl = Url.Action("Create", "Review", new { movieId = Model.MovieId });
    var related = (IEnumerable<Cinemax.Models.Movie>)ViewBag.Related;
}

<section class="detail-hero" style="--hero-image: url('@Model.BackdropUrl')">
    <div class="detail-inner">
        @if (Model.PosterUrl != null)
        {
            <img class="detail-poster" src="@Model.PosterUrl" alt="Poster for @Model.MovieTitle" width="500" height="750" />
        }
        else
        {
            <span class="poster-empty detail-poster">@Model.MovieTitle</span>
        }
        <div class="detail-copy">
            <a class="chip" asp-action="Index" asp-route-genreId="@Model.GenreId">@Model.Genre?.Name</a>
            <h1>@Model.MovieTitle</h1>
            <p class="hero-meta"><span>@Model.ReleaseYear</span><span>@Model.DurationFormatted</span></p>
            <div class="scores">
                @if (Model.TmdbRating is double tmdb)
                {
                    <div class="score-box"><strong>@tmdb.ToString("0.0")</strong><small>TMDB score</small></div>
                }
                @if (Model.AverageRating is double rating)
                {
                    <div class="score-box"><strong>@rating.ToString("0.0")<span>/5</span></strong><small>@Model.Reviews.Count @(Model.Reviews.Count == 1 ? "review" : "reviews")</small></div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Overview))
            {
                <p class="overview">@Model.Overview</p>
            }
            <dl class="facts">
                <dt>Director</dt>
                <dd>@Model.Director</dd>
                @if (!string.IsNullOrWhiteSpace(Model.TopCast))
                {
                    <dt>Cast</dt>
                    <dd>@Model.TopCast</dd>
                }
            </dl>
            <div class="hero-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-primary" href="@writeUrl">Write a review</a>
                }
                else
                {
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@writeUrl">Log in to review</a>
                }
                @if (User.IsInRole("Administrator"))
                {
                    <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.MovieId">Edit movie</a>
                }
            </div>
        </div>
    </div>
</section>

<div class="page">
    <section>
        <div class="section-head">
            <h2>Reviews</h2>
        </div>
        @if (Model.Reviews.Count == 0)
        {
            <p class="empty-state">No reviews yet. Be the first to share your thoughts.</p>
        }
        <div class="review-list">
            @foreach (var review in Model.Reviews.OrderBy(r => r.TmdbReviewId != null).ThenByDescending(r => r.ReviewId))
            {
                <partial name="_ReviewCard" model="review" />
            }
        </div>
    </section>

    @if (related.Any())
    {
        <section>
            <div class="section-head">
                <h2>More in @Model.Genre?.Name</h2>
                <a class="text-link" asp-action="Index" asp-route-genreId="@Model.GenreId">See all</a>
            </div>
            <partial name="_MovieRail" model="related" />
        </section>
    }
</div>
