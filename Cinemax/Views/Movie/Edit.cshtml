@model Cinemax.Models.Movie

@{
    ViewData["Title"] = "Edit movie";
    ViewData["FormAction"] = "Edit";
    ViewData["SubmitText"] = "Save changes";
}

<div class="page narrow">
    <a class="back-link" asp-action="Details" asp-route-id="@Model.MovieId">&larr; Back to movie</a>
    <h1>Edit movie</h1>
    <partial name="_MovieForm" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
