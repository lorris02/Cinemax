@model Cinemax.Models.Movie

@{
    ViewData["Title"] = "Add a movie";
    ViewData["FormAction"] = "Create";
    ViewData["SubmitText"] = "Add movie";
}

<div class="page narrow">
    <a class="back-link" asp-action="Index">&larr; Back to movies</a>
    <h1>Add a movie</h1>
    <div class="tip-card">
        <div>
            <strong>Is it on TMDB?</strong>
            <p>Importing fills in the poster, summary, cast and reviews for you.</p>
        </div>
        <a class="btn btn-ghost btn-sm" asp-controller="MovieImport" asp-action="Index">Add from TMDB</a>
    </div>
    <partial name="_MovieForm" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
