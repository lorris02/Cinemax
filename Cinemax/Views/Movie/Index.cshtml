@model IEnumerable<Cinemax.Models.Movie>

@{
    ViewData["Title"] = "Movies";
    var genres = (IEnumerable<Cinemax.Models.Genre>)ViewBag.Genres;
    int? selected = ViewBag.GenreId;
}

<div class="page">
    <div class="section-head page-head">
        <h1>Movies</h1>
        <div class="head-actions">
            @if (User.IsInRole("Administrator"))
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="MovieImport" asp-action="Index">Add from TMDB</a>
                <a class="btn btn-outline-light btn-sm" asp-action="Create">Add manually</a>
            }
        </div>
    </div>

    <form class="filter-bar" method="get" asp-action="Index" role="search">
        <input class="form-control" type="search" name="q" value="@ViewBag.Query" placeholder="Search by title or director" aria-label="Search movies" />
        <select class="form-select" name="genreId" aria-label="Filter by genre">
            <option value="">All genres</option>
            @foreach (var genre in genres)
            {
                <option value="@genre.GenreId" selected="@(selected == genre.GenreId)">@genre.Name</option>
            }
        </select>
        <button class="btn btn-primary" type="submit">Search</button>
    </form>

    @if (!Model.Any())
    {
        <p class="empty-state">No movies found. Try a different search.</p>
    }
    <div class="movie-grid">
        @foreach (var movie in Model)
        {
            <div>
                <partial name="_MovieCard" model="movie" />
                @if (User.IsInRole("Administrator"))
                {
                    <div class="admin-row">
                        <a asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a>
                        <form asp-action="Delete" asp-route-id="@movie.MovieId" method="post" onsubmit="return confirm('Delete this movie?');">
                            <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
