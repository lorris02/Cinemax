@model IEnumerable<Cinemax.Models.Movie>


@{
    ViewData["Title"] = "Index";
}
<h1>Explore Our Movie Collections</h1>
<p>
    Use the movie list below to explore your favorite directors, compare release dates,
    or check out recent films added to our collection. Stay tuned, we’re always adding more classics and new releases,and also if you will like to add a Movie,pls feel free
</p>

<p>
	@if (User.Identity.IsAuthenticated)//check if user is logged in
    {
        <a asp-action="Create">Add a New Movie</a>
    }
    else
	{
		//i asked ai this,so it redirects the user back to the exact place after login
		//i kmew the area was the identity but i was not sure about the rest
        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "Movie")" class="btn btn-primary">
            Login to add a movie
        </a>

    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
				Movie Title
            </th>
            <th>
                Director
            </th>
            <th>
                Genre
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenreId)
            </th>
            <th>
				Year Released
            </th>
            <th>
				Movie Duration
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MovieTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Director)
            </td>
            <td>
                @item.Genre?.Name
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.GenreId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseYear)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DurationFormatted)
            </td>
            <td>
                  @if (User.IsInRole("Administrator"))
                {
                 <text>
                  <a asp-action="Edit" asp-route-id="@item.MovieId">Edit</a> |
                  <form asp-action="Delete" asp-route-id="@item.MovieId" method="post" class="d-inline" onsubmit="return confirm('Delete this movie?');">
                      <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                  </form>
                  </text>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
<p>
    Unsure which genre to pick? Check out our list of genres and their descriptions <a asp-area="" asp-controller="Genre" asp-action="Index">here</a>
</p>
