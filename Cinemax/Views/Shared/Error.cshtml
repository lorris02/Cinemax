@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page narrow state-page">
    <p class="state-code">Oops</p>
    <h1>Something went wrong</h1>
    <p class="lead-text">We couldn't finish that request. Please try again in a moment.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go home</a>
</div>
