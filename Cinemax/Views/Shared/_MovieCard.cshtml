@model Cinemax.Models.Movie

<a class="movie-card" asp-controller="Movie" asp-action="Details" asp-route-id="@Model.MovieId" title="@Model.MovieTitle">
    <span class="poster">
        @if (Model.PosterUrl != null)
        {
            <img src="@Model.PosterUrl" alt="Poster for @Model.MovieTitle" loading="lazy" width="500" height="750" />
        }
        else
        {
            <span class="poster-empty">@Model.MovieTitle</span>
        }
        @if (Model.CardScore is double score)
        {
            <span class="score-badge"><span aria-hidden="true">&#9733;</span> @score.ToString("0.0")</span>
        }
    </span>
    <span class="movie-card-title">@Model.MovieTitle</span>
    <span class="movie-card-meta">@Model.ReleaseYear</span>
</a>
