@model Cinemax.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
    var featured = Model.Featured;
}

@if (featured != null)
{
    <section class="hero" style="--hero-image: url('@featured.BackdropUrl')">
        <div class="hero-inner">
            <p class="eyebrow">Popular now</p>
            <h1>@featured.MovieTitle</h1>
            <p class="hero-meta">@featured.ReleaseYear &middot; @featured.Genre?.Name &middot; @featured.DurationFormatted</p>
            <p class="hero-text">@featured.Overview</p>
            <a class="btn btn-primary" asp-controller="Movie" asp-action="Details" asp-route-id="@featured.MovieId">See details and reviews</a>
        </div>
    </section>
}
else
{
    <section class="hero hero-plain">
        <div class="hero-inner">
            <h1>Find your next movie</h1>
            <p class="hero-text">Browse the catalogue, then see what other viewers thought.</p>
            <a class="btn btn-primary" asp-controller="Movie" asp-action="Index">Browse movies</a>
        </div>
    </section>
}

<div class="page">
    @if (Model.Movies.Count > 0)
    {
        <div class="section-head">
            <h2>Popular movies</h2>
            <a asp-controller="Movie" asp-action="Index">See all</a>
        </div>
        <div class="movie-grid">
            @foreach (var movie in Model.Movies.Where(m => m != featured).Take(12))
            {
                <partial name="_MovieCard" model="movie" />
            }
        </div>
    }

    @if (Model.LatestReviews.Count > 0)
    {
        <div class="section-head">
            <h2>Latest reviews</h2>
            <a asp-controller="Review" asp-action="Index">See all</a>
        </div>
        <div class="review-list">
            @foreach (var review in Model.LatestReviews)
            {
                <article class="review-card">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@review.MovieId"><strong>@review.Movie?.MovieTitle</strong></a>
                    <partial name="_Stars" model="review.Rating" />
                    <p>@review.ReviewMessage</p>
                    <small>@review.ReviewerName</small>
                </article>
            }
        </div>
    }
</div>
