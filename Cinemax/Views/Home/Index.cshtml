@model Cinemax.Models.HomeViewModel

@{
    ViewData["Title"] = "Find your next movie";
    var featured = Model.Featured;
}

@if (featured != null)
{
    <section class="hero" style="--hero-image: url('@featured.BackdropUrl')">
        <div class="hero-inner">
            <p class="eyebrow">Featured tonight</p>
            <h1>@featured.MovieTitle</h1>
            <p class="hero-meta">
                @if (featured.TmdbRating is double rating)
                {
                    <span class="meta-score">&#9733; @rating.ToString("0.0")</span>
                }
                <span>@featured.ReleaseYear</span><span>@featured.Genre?.Name</span><span>@featured.DurationFormatted</span>
            </p>
            <p class="hero-text">@featured.Overview</p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Movie" asp-action="Details" asp-route-id="@featured.MovieId">See movie</a>
                <a class="btn btn-ghost btn-lg" asp-controller="Movie" asp-action="Index">Browse all</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="hero hero-plain">
        <div class="hero-inner">
            <h1>Find your next movie</h1>
            <p class="hero-text">Browse the catalogue, then see what other viewers thought.</p>
            <a class="btn btn-primary btn-lg" asp-controller="Movie" asp-action="Index">Browse movies</a>
        </div>
    </section>
}

<div class="page home-rows">
    @if (Model.Movies.Count > 0)
    {
        <section>
            <div class="section-head">
                <h2>Popular now</h2>
                <a class="text-link" asp-controller="Movie" asp-action="Index">See all</a>
            </div>
            <partial name="_MovieRail" model="Model.Movies.Where(m => m != featured)" />
        </section>
    }

    @foreach (var row in Model.GenreRows)
    {
        <section>
            <div class="section-head">
                <h2>Top in @row.Genre.Name</h2>
                <a class="text-link" asp-controller="Movie" asp-action="Index" asp-route-genreId="@row.Genre.GenreId">See all</a>
            </div>
            <partial name="_MovieRail" model="row.Movies" />
        </section>
    }

    @if (Model.LatestReviews.Count > 0)
    {
        <section>
            <div class="section-head">
                <h2>Latest reviews</h2>
                <a class="text-link" asp-controller="Review" asp-action="Index">See all</a>
            </div>
            <div class="review-list">
                @foreach (var review in Model.LatestReviews)
                {
                    <partial name="_ReviewCard" model="review" view-data='new ViewDataDictionary(ViewData) { ["ShowMovie"] = true }' />
                }
            </div>
        </section>
    }
</div>
