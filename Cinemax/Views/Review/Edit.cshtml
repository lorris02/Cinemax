@model Cinemax.Models.Review

@{
    ViewData["Title"] = "Edit review";
}

<div class="page narrow">
    <a class="back-link" asp-action="Index">&larr; Back to reviews</a>
    <h1>Edit review</h1>
    <form asp-action="Edit" class="form-card">
        <input type="hidden" asp-for="ReviewId" />
        <partial name="_ReviewFields" model="Model" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
