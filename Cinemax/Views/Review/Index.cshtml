@model IEnumerable<Cinemax.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<div class="page narrow">
    <div class="section-head page-head">
        <h1>Reviews</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">Write a review</a>
        }
        else
        {
            <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "Review")">Log in to review</a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="empty-state">No reviews yet. Pick a movie and write the first one.</p>
    }
    <div class="review-list single">
        @foreach (var item in Model)
        {
            <article class="review-card">
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@item.MovieId"><strong>@item.Movie?.MovieTitle</strong></a>
                <partial name="_Stars" model="item.Rating" />
                <p>@item.ReviewMessage</p>
                <small>@item.ReviewerName</small>
                @if (User.IsInRole("Administrator"))
                {
                    <div class="admin-row">
                        <a asp-action="Edit" asp-route-id="@item.ReviewId">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.ReviewId" method="post" onsubmit="return confirm('Delete this review?');">
                            <button type="submit" class="btn btn-link p-0 text-danger">Delete</button>
                        </form>
                    </div>
                }
            </article>
        }
    </div>
</div>
