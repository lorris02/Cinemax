@model IEnumerable<Cinemax.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<div class="page">
    <div class="section-head page-head">
        <div>
            <h1>Reviews</h1>
            <p class="lead-text">What viewers are saying</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-action="Create">Write a review</a>
        }
        else
        {
            <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "Review")">Log in to review</a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="empty-state">No reviews yet. Pick a movie and write the first one.</p>
    }
    <div class="review-list">
        @foreach (var item in Model)
        {
            <partial name="_ReviewCard" model="item" view-data='new ViewDataDictionary(ViewData) { ["ShowMovie"] = true }' />
        }
    </div>
    <partial name="_Pager" />
</div>
