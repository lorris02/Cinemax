@model Cinemax.Models.Review

<div asp-validation-summary="ModelOnly" class="form-error"></div>
@if (ViewBag.Movie is Cinemax.Models.Movie movie)
{
    <input type="hidden" asp-for="MovieId" />
    <div class="review-target">
        @if (movie.PosterUrl != null)
        {
            <img src="@movie.PosterUrl" alt="" width="500" height="750" />
        }
        <div>
            <small>You're reviewing</small>
            <strong>@movie.MovieTitle</strong>
            <span>@movie.ReleaseYear</span>
        </div>
    </div>
}
else
{
    <div class="field">
        <label asp-for="MovieId">Movie</label>
        <select asp-for="MovieId" class="form-select" asp-items="ViewBag.MovieId"></select>
        <span asp-validation-for="MovieId" class="field-error"></span>
    </div>
}
<fieldset class="field">
    <legend>Your rating</legend>
    <div class="star-input">
        @for (var star = 5; star >= 1; star--)
        {
            <input type="radio" id="star-@star" name="Rating" value="@star" checked="@(Model?.Rating == star)" />
            <label for="star-@star" title="@star out of 5"><span class="visually-hidden">@star out of 5</span>&#9733;</label>
        }
    </div>
    <span asp-validation-for="Rating" class="field-error"></span>
</fieldset>
<div class="field">
    <label asp-for="ReviewerName">Display name</label>
    <input asp-for="ReviewerName" class="form-control" placeholder="How your name appears" autocomplete="nickname" />
    <span asp-validation-for="ReviewerName" class="field-error"></span>
</div>
<div class="field">
    <label asp-for="ReviewMessage">Your review</label>
    <textarea asp-for="ReviewMessage" class="form-control" rows="6" placeholder="What did you think?"></textarea>
    <span asp-validation-for="ReviewMessage" class="field-error"></span>
</div>
