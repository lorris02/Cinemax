@model Cinemax.Models.Review

@{
    ViewData["Title"] = "Write a review";
}

<div class="page narrow">
<h1>Write a review</h1>
<div>
    <div>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ReviewerName" class="control-label">Name</label>
                <input asp-for="ReviewerName" class="form-control" />
                <span asp-validation-for="ReviewerName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReviewMessage" class="control-label">Review</label>
                <textarea asp-for="ReviewMessage" class="form-control" rows="5"></textarea>
                <span asp-validation-for="ReviewMessage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rating" class="control-label">Rating (1 to 5)</label>
                <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MovieId" class="control-label">Movie Title</label>
                <select asp-for="MovieId" class ="form-control" asp-items="ViewBag.MovieId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Post review" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<a asp-action="Index">Back to reviews</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
