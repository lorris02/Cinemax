@page
@using Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal
@model IndexModel
@{
    ViewData["Title"] = "Your profile";
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="profile-card">
    <span class="avatar avatar-lg" aria-hidden="true">@(string.IsNullOrEmpty(Model.Username) ? "?" : Model.Username[..1].ToUpperInvariant())</span>
    <div>
        <small>Signed in as</small>
        <strong>@Model.Username</strong>
    </div>
</div>
<form id="profile-form" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
    <div class="field">
        <label asp-for="Input.PhoneNumber">Phone number <span class="optional">Optional</span></label>
        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Your phone number" />
        <span asp-validation-for="Input.PhoneNumber" class="field-error"></span>
    </div>
    <div class="form-actions">
        <button id="update-profile-button" type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
