@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password changed";
}

<div class="account-form">
    <h1>Password changed</h1>
    <div class="form-card account-note">
        <p>Your new password is saved.</p>
        <a class="w-100 btn btn-lg btn-primary" asp-page="./Login">Log in</a>
    </div>
</div>
