@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}

<div class="account-form">
    <h1>Check your email</h1>
    <div class="form-card account-note">
        <p>If that email has a confirmed account, a link to reset your password is on its way.</p>
        <p class="muted-note">The link works once. Check your spam folder if it doesn't arrive.</p>
    </div>
    <p class="account-switch"><a asp-page="./Login">Back to log in</a></p>
</div>
